{% extends 'base.html.twig' %}

{% block body %}
    <h1>{{ produto ? 'Editar produto' : 'Novo produto' }}</h1>

    <form method="post">
        <div>
            <label for="nome">Nome</label>
            <input type="text" id="nome" name="nome" value="{{ produto ? produto.nome : '' }}" required>
        </div>

        <div>
            <label for="quantidade">Quantidade</label>
            <input type="number" id="quantidade" name="quantidade" value="{{ produto ? produto.quantidade : 0 }}" min="0" required>
        </div>

        <div>
            <label for="categoria">Categoria</label>
            <select id="categoria" name="categoria" required>
                {% for categoria in categorias %}
                    <option value="{{ categoria.id }}" {{ produto and produto.categoria.id == categoria.id ? 'selected' : '' }}>
                        {{ categoria.nome }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <button type="submit">Salvar</button>
        <a href="{{ path('produto_listar') }}">Cancelar</a>
    </form>
{% endblock %}